{
  "name": "wicroduck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "All-in-one, 100% in-browser tooling for the Microduck RL pipeline.",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
