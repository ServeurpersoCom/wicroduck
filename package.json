{
  "name": "wicroduck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "All-in-one, 100% in-browser tooling for the Microduck RL pipeline.",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check:env": "node scripts/check-env.ts",
    "check:standup": "node scripts/check-standup.mjs",
    "check:grad": "node scripts/check-grad.ts",
    "check:ppo": "node scripts/check-ppo.ts",
    "check:trainer": "node scripts/check-trainer.ts",
    "check": "node scripts/check-node-compat.mjs && npm run typecheck && npm run check:grad && npm run check:kernels && npm run check:ppo && npm run check:env && npm run check:trainer",
    "profile": "node scripts/profile-train.ts",
    "build:kernels": "node scripts/build-kernels.mjs",
    "check:kernels": "node scripts/check-kernels.ts"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.12.0",
    "onnxruntime-web": "^1.23.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/three": "^0.180.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
